# B4.1 SENTIMENT ANALYSIS
# -----------------------------------

POSITIVE = {"good", "clean", "fast", "helpful", "improved"}
NEGATIVE = {"bad", "dirty", "slow", "rude", "smoke", "broken"}
NEGATORS = {"not", "never", "no"}

def score(text):
    words = re.findall(r"[a-z']+", text.lower())
    total = 0

    for i, word in enumerate(words):
        value = 1 if word in POSITIVE else -1 if word in NEGATIVE else 0

        if i > 0 and words[i - 1] in NEGATORS:
            value = -value

        total += value

    return total


def label(text):
    s = score(text)

    if s > 0:
        return "positive"
    elif s < 0:
        return "negative"
    return "neutral"


# -----------------------------------
# EXTRACTIVE SUMMARISER
# -----------------------------------

def summarise(text, k=2):
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    stop_words = {
        "the", "a", "an", "is", "are", "was",
        "were", "and", "of", "to", "in", "from"
    }

    words = [
        re.findall(r"[a-z']+", sentence.lower())
        for sentence in sentences
    ]

    frequency = Counter(
        word for sentence in words
        for word in sentence if word not in stop_words
    )

    ranked = sorted(
        range(len(sentences)),
        key=lambda i: sum(
            frequency[word]
            for word in words[i]
            if word not in stop_words
        ),
        reverse=True
    )

    selected = sorted(ranked[:k])

    return " ".join(sentences[i] for i in selected)


