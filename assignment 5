# -----------------------------------
# B4.2 SQLITE DATABASE AND INDEX
# -----------------------------------

print("\nDATABASE PERFORMANCE TEST")

con = sqlite3.connect(":memory:")

con.execute("""
CREATE TABLE readings (
    station TEXT,
    day TEXT,
    pm25 REAL
)
""")

# Generate 100 stations with 15-minute readings
random.seed(42)

rows = []

for station in range(100):
    for day in range(30):
        for reading in range(96):
            rows.append((
                f"Station_{station}",
                f"2026-10-{day+1:02d}",
                random.uniform(10, 200)
            ))

con.executemany(
    "INSERT INTO readings VALUES (?, ?, ?)",
    rows
)

con.commit()

print("Total Readings:", len(rows))


# Query before index
query = """
SELECT AVG(pm25)
FROM readings
WHERE station = ? AND day = ?
"""

start = time.perf_counter()

for _ in range(100):
    con.execute(
        query,
        ("Station_50", "2026-10-15")
    ).fetchone()

before = time.perf_counter() - start


# Create index
con.execute("""
CREATE INDEX idx_station_day
ON readings(station, day)
""")

con.commit()


# Query after index
start = time.perf_counter()

for _ in range(100):
    con.execute(
        query,
        ("Station_50", "2026-10-15")
    ).fetchone()

after = time.perf_counter() - start

print("Time Before Index:", round(before, 5), "seconds")
print("Time After Index:", round(after, 5), "seconds")

if after > 0:
    print("Performance Ratio:", round(before / after, 2))


